---
import Base from "../../layouts/Base.astro";
import GroundTrack from "../../components/wall/GroundTrack.astro";
import Nav from "../../components/Nav.astro";
import CaseSections from "../../components/CaseSections.astro";
import Icon from "../../components/ui/Icon.astro";
import { profile, experience } from "../../data/profile";
import { caseStudies } from "../../data/case-studies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: `${study.title.lead} ${study.title.accent}`,
  description: study.metaDescription,
  url: new URL(`/case-studies/${study.slug}/`, import.meta.env.SITE).href,
  author: {
    "@type": "Person",
    name: profile.fullName,
    url: import.meta.env.SITE,
  },
  about: study.stack,
});

const { facts, tagline } = study;

// the role this study documents; only the current one gets the lime marker
const role = experience.find((r) => r.refs.some((ref) => ref.href === `/case-studies/${study.slug}/`));
if (!role) throw new Error(`No experience entry links to /case-studies/${study.slug}/`);
const live = role.period.includes("Present");
---

<Base
  title={study.metaTitle}
  description={study.metaDescription}
  path={`/case-studies/${study.slug}/`}
>
  <script type="application/ld+json" set:html={articleJsonLd} is:inline />
  <GroundTrack focus={role.station} />
  <Nav />

  <header class="head wrap">
    <a class="link" href="/"><Icon name="arrow-left" />back to portfolio</a>

    <h1 class="title">{study.title.lead} {study.title.accent}</h1>
    <p class="tagline">{tagline}</p>

    <dl class="facts mono">
      {
        facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>
              {live && fact.label === "period" && <span class="dot" aria-hidden="true" />}
              {fact.href ? (
                <a href={fact.href} target="_blank" rel="noopener noreferrer">
                  {fact.value.slice(0, fact.value.lastIndexOf(" ") + 1)}
                  <span class="nowrap">
                    {fact.value.slice(fact.value.lastIndexOf(" ") + 1)}<Icon name="arrow-up-right" />
                  </span>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              ) : (
                fact.value
              )}
              {fact.label === "company" && <span class="station-tag">{role.station}</span>}
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="stack" aria-label="Stack" data-wall-clear>
      {study.stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
  </header>

  <main class="wrap">
    <CaseSections sections={study.sections} />
  </main>

  <footer class="foot wrap">
    <div class="foot-actions">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>ask me about it<Icon name="mail" /></a>
      <a class="btn" href="/"><Icon name="arrow-left" />back to portfolio</a>
    </div>
  </footer>
</Base>

<style>
  .head {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 7vw, 6rem));
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .title {
    max-width: 14ch;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    font-weight: 700;
    font-stretch: 88%;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .tagline {
    max-width: 40ch;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  /* facts: label over value, one hairline row */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 1.25rem 1.5rem;
    max-width: 52rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
  }

  .fact dt {
    color: var(--text-faint);
  }

  .fact dd {
    margin-top: 0.4rem;
    color: var(--text);
  }

  .fact .dot {
    margin-right: 0.6em;
  }

  /* the icon rides with the last word, so a wrapped value never orphans it */
  .fact a {
    text-decoration: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  .fact a :global(.icon) {
    display: inline-block;
    margin-left: 0.3em;
    vertical-align: -0.2em;
  }

  .fact a:hover {
    color: var(--accent);
  }

  /* the market this work ran in, under the company: the same station the map pins */
  .station-tag {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.5rem;
    color: var(--text-soft);
  }

  .station-tag::before {
    content: "";
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
  }

  .stack {
    list-style: none;
    padding: 0;
    max-width: 52rem;
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* chips stay legible where a station label or the trace passes under them */
  .stack .tag {
    background: var(--surface);
  }

  /* tablet up: the map masks its trace off the left 52vw and pins this role's station
     right of it, so the header copy ends at that line (page x 52vw, minus the wrap's left edge) */
  @media (min-width: 768px) {
    .head {
      --clear: calc(52vw - max(var(--gutter), (100vw - 74rem) / 2 + var(--gutter)));
    }

    .title {
      max-width: min(14ch, var(--clear));
    }

    .tagline {
      max-width: min(40ch, var(--clear));
    }

    .facts,
    .stack {
      max-width: var(--clear);
    }
  }

  .foot {
    padding-bottom: var(--space-section);
  }

  .foot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: calc(var(--space-section) / 2);
    border-top: 1px solid var(--line);
  }
</style>
