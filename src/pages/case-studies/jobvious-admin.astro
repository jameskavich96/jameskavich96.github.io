---
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/profile";

const title = "Case Study: Jobvious Admin Platform — James Delos Reyes";
const description =
  "How I designed and built a 9-module React + TypeScript admin platform end-to-end on a custom design system for an AI-powered recruitment platform.";

const stack = [
  "React",
  "TypeScript",
  "Vite",
  "Tailwind",
  "Radix UI",
  "TanStack Query",
  "Zustand",
  "NestJS API",
  "Socket.io",
];

const modules = [
  "approvals",
  "participant management",
  "notifications",
  "messaging",
  "timesheet export",
  "moderation",
  "reports",
  "promotions",
  "settings",
];
---

<Base title={title} description={description} path="/case-studies/jobvious-admin/">
  <div class="wrap">
    <nav class="masthead" aria-label="Main navigation">
      <a class="back" href="/">← cd ~</a>
      <span class="dim">case study 01</span>
    </nav>
  </div>

  <main class="wrap study">
    <header class="study-head">
      <h1>Jobvious <span class="accent">Admin Platform</span></h1>
      <p class="tagline">
        <span class="comment">// a 9-module admin SPA, designed and built end-to-end</span>
      </p>
      <dl class="facts">
        <div><dt>role</dt><dd>full stack developer — sole owner of the redesign</dd></div>
        <div><dt>period</dt><dd>2025 — present</dd></div>
        <div><dt>company</dt><dd><a href="https://itsjobvious.com" target="_blank" rel="noopener noreferrer">Jobvious ↗</a></dd></div>
      </dl>
      <ul class="chips" aria-label="Stack">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </header>

    <section class="section" aria-labelledby="problem-h">
      <div class="section-grid">
        <p class="kicker"><span class="no">01</span>$ cat problem.md</p>
        <div>
          <h2 id="problem-h" class="sr-only">The problem</h2>
          <p>
            Jobvious is an AI-powered recruitment and referral platform. Its operations team ran
            the business — approving participants, moderating content, exporting timesheets,
            answering messages — through an aging admin interface that hadn't kept pace with the
            product. Every new platform feature made the gap worse: more manual steps, more
            context-switching, more time per task.
          </p>
          <p class="soft">
            The brief: redesign the entire admin surface, not as a reskin but as a rebuild —
            while the operations team kept using it daily.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="approach-h">
      <div class="section-grid">
        <p class="kicker"><span class="no">02</span>$ cat approach.md</p>
        <div>
          <h2 id="approach-h" class="sr-only">The approach</h2>
          <p>
            I designed and built the new platform as a React + TypeScript SPA on a
            <strong>custom design system</strong> — tokens, primitives, and composed components on
            Radix UI, so all nine modules share one visual and interaction language:
          </p>
          <ul class="mod-list">
            {modules.map((m) => <li>{m}</li>)}
          </ul>
          <p>
            Server state runs through TanStack Query (caching, optimistic updates, background
            revalidation against the NestJS API); client state through Zustand. Live chat and
            push-notification flows ride the platform's Socket.io channels, so admins see events
            as they happen. Data visualizations are <strong>hand-coded SVG</strong> — no chart
            library — sized to exactly what the reporting modules need.
          </p>
          <p class="soft">
            Being the sole owner meant every layer was mine: information architecture, the design
            system, component code, API integration, and the rollout.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="outcome-h">
      <div class="section-grid">
        <p class="kicker"><span class="no">03</span>$ cat outcome.md</p>
        <div>
          <h2 id="outcome-h" class="sr-only">The outcome</h2>
          <ul class="outcomes">
            <li>
              Nine modules shipped on one coherent design system — new admin features now compose
              from existing primitives instead of starting from zero.
            </li>
            <li>
              The operations team runs approvals, moderation, messaging, and timesheet export in
              one place, with real-time updates replacing manual refresh-and-check loops.
            </li>
            <li>
              {/* TODO(james): add 1–2 real numbers — e.g. time saved per approval,
                  support tickets handled per day, adoption feedback from the ops team */}
              PLACEHOLDER: a concrete metric or a line of feedback from the operations team.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <footer class="study-foot">
      <a class="cta" href={`mailto:${profile.email}`}
        ><span class="accent">$</span> ask me about it</a
      >
      <a class="back" href="/">← back to portfolio</a>
    </footer>
  </main>
</Base>

<style>
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--line);
    padding-block: 1.5rem 1rem;
  }

  .back {
    color: var(--accent);
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .dim {
    color: var(--text-soft);
  }

  .study-head {
    padding-block: clamp(3rem, 8vw, 6rem) 1rem;
  }

  .study-head h1 {
    font-size: clamp(2rem, 1rem + 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .accent {
    color: var(--accent);
  }

  .tagline {
    margin-top: 1rem;
  }

  .comment {
    color: var(--accent-deep);
    font-style: italic;
  }

  .facts {
    margin-top: 2rem;
    display: grid;
    gap: 0.4rem;
    max-width: var(--measure);
  }

  .facts div {
    display: flex;
    gap: 1.5rem;
  }

  .facts dt {
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-soft);
    min-width: 6rem;
    line-height: inherit;
  }

  .facts dd {
    margin: 0;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chips li {
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 0.3rem 0.8rem;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
  }

  .study p {
    max-width: var(--measure);
  }

  .study p + p,
  .study ul + p,
  .study p + ul {
    margin-top: 1.25rem;
  }

  .soft {
    color: var(--text-soft);
  }

  .mod-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.5rem;
    max-width: var(--measure);
  }

  .mod-list li {
    padding-left: 1.4rem;
    position: relative;
  }

  .mod-list li::before,
  .outcomes li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .outcomes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
  }

  .outcomes li {
    padding-left: 1.4rem;
    position: relative;
  }

  .study-foot {
    border-top: 1px solid var(--line);
    margin-top: calc(var(--space-section) / 2);
    padding-block: 2.5rem 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    align-items: baseline;
  }

  .cta {
    font-size: clamp(1.2rem, 1rem + 1.5vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .cta:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
</style>
