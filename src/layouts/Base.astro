---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
}

const { title = `${profile.fullName} — ${profile.role}` } = Astro.props;
const description = `${profile.headline.lead} ${profile.headline.accent} Portfolio of ${profile.fullName}, ${profile.role.toLowerCase()}.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      // reveal-on-scroll; reduced-motion users get everything visible via CSS
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
