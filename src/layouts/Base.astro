---
import "../styles/global.css";
import { profile, SITE_URL } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  /** path for the canonical URL, e.g. "/" or "/case-studies/jobvious/" */
  path?: string;
}

const {
  title = `${profile.fullName} — ${profile.role}`,
  description = `${profile.headline.lead} ${profile.headline.accent} Portfolio of ${profile.fullName}, ${profile.role.toLowerCase()} in ${profile.location} with 8+ years across React, TypeScript, NestJS, and AI integration.`,
  path = "/",
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL("/og.png", SITE_URL).href;

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: SITE_URL,
  address: { "@type": "PostalAddress", addressLocality: "Cebu", addressCountry: "PH" },
  sameAs: [profile.links.github, profile.links.linkedin],
  worksFor: { "@type": "Organization", name: "Jobvious", url: "https://itsjobvious.com" },
  knowsAbout: [
    "TypeScript",
    "React",
    "Node.js",
    "NestJS",
    "AI integration",
    "OpenAI API",
    "RAG pipelines",
    "Vector search",
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.fullName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={personJsonLd} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      // reveal-on-scroll; reduced-motion users get everything visible via CSS
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
