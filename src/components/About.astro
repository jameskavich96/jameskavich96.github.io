---
import { profile } from "../data/profile";
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">01</span>about.md</p>
    <div class="reveal">
      <h2 id="about-heading" class="sr-only">About</h2>
      {profile.about.map((para, i) => <p class:list={["about-para", { lede: i === 0 }]} set:html={para} />)}
    </div>
  </div>
</section>

<style>
  .about-para {
    max-width: var(--measure);
  }

  .about-para + .about-para {
    margin-top: 1.5rem;
    color: var(--text-soft);
  }

  .about-para :global(strong) {
    color: var(--accent);
    font-weight: 700;
  }

  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.55rem);
    line-height: 1.55;
    font-weight: 600;
  }
</style>
