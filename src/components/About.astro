---
import { profile } from "../data/profile";
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">01</span>about.md</p>
    <div class="reveal">
      <h2 id="about-heading" class="sr-only">About</h2>
      {profile.about.map((para, i) => <p class:list={["about-para", { lede: i === 0 }]}>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .about-para {
    max-width: var(--measure);
  }

  .about-para + .about-para {
    margin-top: 1.5rem;
    color: var(--text-soft);
  }

  .lede {
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.35rem);
    line-height: 1.7;
    font-weight: 500;
  }
</style>
