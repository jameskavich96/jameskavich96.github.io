---
import { profile } from "../data/profile";
---

<section class="section" aria-labelledby="about-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">01</span>About</p>
    <div class="reveal">
      <h2 id="about-heading" class="sr-only">About</h2>
      {profile.about.map((para, i) => <p class:list={["about-para", { lede: i === 0 }]}>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .about-para {
    max-width: var(--measure);
  }

  .about-para + .about-para {
    margin-top: 1.25rem;
    color: var(--ink-soft);
  }

  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 1.9rem);
    line-height: 1.4;
    font-weight: 460;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
