---
import { skills } from "../data/profile";
---

<section class="section" aria-labelledby="skills-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">04</span>$ ls ./toolkit</p>
    <div class="groups reveal">
      <h2 id="skills-heading" class="sr-only">Skills</h2>
      {
        skills.map((group) => (
          <div class="group">
            <h3 class="group-label"># {group.label.toLowerCase()}</h3>
            <ul class="chips">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 2.25rem;
  }

  .group-label {
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chips li {
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 0.35rem 0.85rem;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .chips li:hover {
    border-color: var(--accent-deep);
    color: var(--accent);
  }
</style>
