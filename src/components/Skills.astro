---
import { skills } from "../data/profile";

const toKey = (label: string) => label.toLowerCase().replace(/\s+/g, "_");
---

<section id="toolkit" class="section" aria-labelledby="skills-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">04</span>toolkit.json</p>
    <div class="reveal">
      <h2 id="skills-heading" class="sr-only">Skills</h2>
      <pre class="json"><code><span class="p">&#123;</span>
{skills.map((group, gi) => (
  <>  <span class="key">"{toKey(group.label)}"</span><span class="p">: [</span>
{group.items.map((item, i) => (
    <>    <span class="str">"{item}"</span><span class="p">{i < group.items.length - 1 ? "," : ""}</span>
</>
))}  <span class="p">]{gi < skills.length - 1 ? "," : ""}</span>
</>
))}<span class="p">&#125;</span></code></pre>
    </div>
  </div>
</section>

<style>
  .json {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    overflow-x: auto;
    font-size: clamp(0.8rem, 0.75rem + 0.25vw, 0.95rem);
    line-height: 2;
  }

  .p {
    color: var(--text-soft);
  }

  .key {
    color: var(--syn-key);
  }

  .str {
    color: var(--syn-string);
  }
</style>
