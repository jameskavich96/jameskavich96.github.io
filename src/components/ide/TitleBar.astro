---
interface Props {
  title?: string;
}
const { title = "james-delos-reyes — portfolio" } = Astro.props;
---

<div class="titlebar">
  <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="title">{title}</span>
  <span class="brand">dr<span class="dim">.james</span></span>
</div>

<style>
  .titlebar {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--titlebar-h);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    color: var(--text-soft);
  }

  .dots {
    display: inline-flex;
    gap: 0.45rem;
  }

  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: oklch(68% 0.18 25);
  }

  .dots i:nth-child(2) {
    background: oklch(80% 0.14 85);
  }

  .dots i:nth-child(3) {
    background: oklch(72% 0.17 145);
  }

  .title {
    flex: 1;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .brand .dim {
    color: var(--text-soft);
    font-weight: 400;
  }
</style>
