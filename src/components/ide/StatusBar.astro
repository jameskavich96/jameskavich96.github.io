---
import { profile } from "../../data/profile";
---

<div class="statusbar" role="contentinfo">
  <span class="item">⎇ main</span>
  <span class="item dr"><span class="pulse" aria-hidden="true"></span> the dr. is in</span>
  <span class="spacer"></span>
  <a class="item" href={`mailto:${profile.email}`}>✉ {profile.email}</a>
  <span class="item hide-sm">{profile.location.toLowerCase()}</span>
  <span class="item hide-sm">UTF-8</span>
  <span class="item hide-sm">TypeScript React</span>
</div>

<style>
  .statusbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 30;
    height: var(--status-h);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-inline: 1rem;
    background: var(--status-bg);
    color: white;
    font-family: var(--font-ui);
    font-size: var(--text-small);
    overflow: hidden;
    white-space: nowrap;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  a.item {
    color: inherit;
    text-decoration: none;
  }

  a.item:hover {
    color: white;
    text-decoration: underline;
  }

  .spacer {
    flex: 1;
  }

  .pulse {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--live);
  }

  @media (max-width: 640px) {
    .hide-sm {
      display: none;
    }
  }
</style>
