---
// Slim top nav: brand, section links with scroll-spy, resume.
// On the home page links are in-page anchors; elsewhere they point back to "/".
import Icon from "./ui/Icon.astro";
import { profile } from "../data/profile";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? "" : "/";

const links = [
  { label: "Work", id: "work" },
  { label: "Experience", id: "experience" },
  { label: "AI", id: "ai" },
  { label: "About", id: "about" },
  { label: "Contact", id: "contact" },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" data-brand>dr<span class="dot-char">.</span>james</a>
    <nav class="links" aria-label="Main navigation">
      {
        links.map((l) => (
          <a class="nav-link" href={`${base}#${l.id}`} data-spy={home ? l.id : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="btn nav-resume" href={profile.links.resume} download>
      resume.pdf <Icon name="download" />
    </a>
  </div>
</header>

<script>
  // brand click on the home page scrolls up and drops the #hash instead of reloading
  document.querySelector<HTMLAnchorElement>("[data-brand]")?.addEventListener("click", (e) => {
    if (location.pathname === "/") {
      e.preventDefault();
      history.replaceState(null, "", "/");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // scroll-spy: mark the link of the section under the probe line
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
  const sections = links
    .map((l) => document.getElementById(l.dataset.spy!))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const setActive = (id: string | null) => {
      for (const l of links) {
        if (l.dataset.spy === id) l.setAttribute("aria-current", "location");
        else l.removeAttribute("aria-current");
      }
    };

    let lastY = window.scrollY;
    let queued = false;
    const update = () => {
      queued = false;
      const y = window.scrollY;
      // drop the #hash only when arriving back at the top from below
      if (y < 40 && lastY >= 40 && location.hash) history.replaceState(null, "", location.pathname);
      lastY = y;
      if (window.innerHeight + y >= document.documentElement.scrollHeight - 2) {
        setActive(sections[sections.length - 1].id);
        return;
      }
      const probe = window.innerHeight * 0.35;
      let current: string | null = null;
      for (const s of sections) if (s.getBoundingClientRect().top <= probe) current = s.id;
      setActive(current);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    height: var(--nav-h);
    background: rgb(11 13 11 / 0.82);
    /* legibility only: the map scrolls under the nav */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .dot-char {
    color: var(--accent);
  }

  .links {
    display: none;
    gap: 0.25rem;
    margin-left: auto;
  }

  @media (min-width: 820px) {
    .links {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-faint);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link[aria-current] {
    color: var(--text);
  }

  .nav-link[aria-current]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 4px;
    height: 4px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav-resume {
    margin-left: auto;
    min-height: 2.25rem;
    padding-block: 0.4rem;
  }

  @media (min-width: 820px) {
    .nav-resume {
      margin-left: 0;
    }
  }
</style>
