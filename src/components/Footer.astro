---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer id="contact" class="section footer" aria-labelledby="contact-heading">
  <div class="wrap">
    <p class="kicker"><span class="no">05</span>contact.sh</p>
    <h2 id="contact-heading" class="cta reveal">
      <a href={`mailto:${profile.email}`}
        ><span class="prompt" aria-hidden="true">$</span> let's talk<span class="cursor" aria-hidden="true"
          >_</span
        ></a
      >
    </h2>
    <div class="colophon">
      <span>{profile.email}</span>
      <span>
        <a href={profile.links.github}>github</a> · <a href={profile.links.linkedin}>linkedin</a>
      </span>
      <span>© {year} {profile.fullName.toLowerCase()}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--panel);
  }

  .cta {
    margin-block: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 6.5vw, 6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .cta a {
    text-decoration: none;
  }

  .prompt {
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    color: var(--text-soft);
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
</style>
