---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer id="contact" class="section footer" aria-labelledby="contact-heading">
  <div class="wrap">
    <p class="kicker"><span class="no">04</span>Contact</p>
    <h2 id="contact-heading" class="cta reveal">
      <a href={`mailto:${profile.email}`}>Let’s talk<span class="dot">.</span></a>
    </h2>
    <div class="colophon">
      <span>{profile.email}</span>
      <span>
        <a href={profile.links.github}>GitHub</a> · <a href={profile.links.linkedin}>LinkedIn</a>
      </span>
      <span>© {year} {profile.fullName}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper-deep);
  }

  .cta {
    margin-block: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cta a {
    text-decoration: none;
  }

  .cta a:hover {
    font-style: italic;
  }

  .dot {
    color: var(--accent);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
</style>
