---
import { experience } from "../data/profile";
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="wrap section-grid">
    <p class="kicker"><span class="no">02</span>$ history --all</p>
    <div>
      <h2 id="experience-heading" class="sr-only">Experience</h2>
      <ol class="roles">
        {
          experience.map((role, i) => (
            <li class="role reveal">
              <span class="ghost-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div class="role-head">
                <h3 class="role-title">
                  {role.title}{" "}
                  <a class="role-at" href={role.companyUrl} target="_blank" rel="noopener noreferrer"
                    >@ {role.company}</a
                  >
                </h3>
                <p class="role-period">{role.period}</p>
              </div>
              <p class="role-summary">{role.summary}</p>
              {role.bullets.length > 0 && (
                <ul class="role-bullets">
                  {role.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              <div class="role-refs">
                {role.refs.map((ref) =>
                  ref.href ? (
                    <a href={ref.href} target="_blank" rel="noopener noreferrer">
                      {ref.label} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="ref-note">{ref.label}</span>
                  ),
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .roles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .role {
    position: relative;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 1.75rem clamp(1.25rem, 3vw, 2.25rem);
    overflow: hidden;
    transition: border-color 250ms ease;
  }

  .role:hover {
    border-color: var(--accent-deep);
  }

  .ghost-no {
    position: absolute;
    top: 0.25rem;
    right: 0.75rem;
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    pointer-events: none;
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-right: 3.5rem;
  }

  .role-title {
    font-size: var(--text-role);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .role-at {
    color: var(--accent);
    text-decoration: none;
  }

  .role-at:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .role-period {
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
  }

  .role-summary {
    margin-top: 0.6rem;
    color: var(--text-soft);
    max-width: var(--measure);
  }

  .role-bullets {
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
    display: grid;
    gap: 0.6rem;
  }

  .role-bullets li {
    padding-left: 1.4rem;
    position: relative;
  }

  .role-bullets li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .role-refs {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-size: var(--text-small);
    letter-spacing: 0.08em;
  }

  .role-refs a {
    color: var(--accent-deep);
    text-decoration: none;
  }

  .role-refs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .ref-note {
    color: var(--text-soft);
  }
</style>
