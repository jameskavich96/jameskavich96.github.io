---
// One authored icon set: 24px grid, square caps, stroke from .icon in global.css.
interface Props {
  name: "arrow-right" | "arrow-left" | "arrow-up-right" | "download" | "mail";
  class?: string;
}

const paths: Record<Props["name"], string> = {
  "arrow-right": "M4 12h15M13 6l6 6-6 6",
  "arrow-left": "M20 12H5M11 6l-6 6 6 6",
  "arrow-up-right": "M7 17 17 7M9 7h8v8",
  download: "M12 4v11M6.5 10l5.5 5.5 5.5-5.5M5 20h14",
  mail: "M3.5 6h17v12h-17zM3.5 6l8.5 7 8.5-7",
};

const { name, class: className } = Astro.props;
---

<svg class:list={["icon", className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={paths[name]}></path>
</svg>
