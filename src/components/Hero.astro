---
import { profile } from "../data/profile";
const [first, ...rest] = profile.fullName.split(" ");
const lastName = rest.join(" ");
---

<header class="hero wrap">
  <h1 class="headline">
    {first}
    <span class="accent">{lastName}</span>
  </h1>

  <p class="tagline reveal">
    <span class="comment">// {profile.drLine}</span>
    <span class="dr-line"
      >{profile.headline.lead.toLowerCase()} {profile.headline.accent}</span
    >
  </p>

  <dl class="stats reveal">
    {
      profile.stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="byline reveal">
    <span>{profile.role.toLowerCase()}</span>
    <span aria-hidden="true">·</span>
    <span>{profile.location.toLowerCase()}</span>
    <span aria-hidden="true">·</span>
    <a href={profile.links.github}>github</a>
    <span aria-hidden="true">·</span>
    <a href={profile.links.linkedin}>linkedin</a>
  </div>
</header>

<style>
  .hero {
    min-height: calc(88svh - var(--titlebar-h) - var(--tabs-h));
    display: flex;
    flex-direction: column;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .headline {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-top: auto;
    text-wrap: balance;
  }

  .headline .accent {
    color: var(--accent);
    /* last name stays whole on its own line */
    display: block;
    white-space: nowrap;
  }

  .tagline {
    margin-top: 1.25rem;
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.2rem);
  }

  .comment {
    font-family: var(--font-mono);
    color: var(--accent-deep);
    font-style: italic;
  }

  .dr-line {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }

  .stats {
    margin-block: clamp(2rem, 5vw, 3.5rem) auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .stat {
    padding: 1.1rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .stat + .stat {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .stat + .stat {
      border-top: none;
      border-left: 1px solid var(--line);
    }
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    color: var(--accent);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    color: var(--text-soft);
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
</style>
