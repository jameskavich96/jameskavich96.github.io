---
// First viewport: the name, the promise, the proof line, the ways in.
// Copy holds the left ~52% on desktop so the map's PH / AU / US stations read beside it.
import { profile } from "../data/profile";
import Icon from "./ui/Icon.astro";

const [first, ...rest] = profile.fullName.split(" ");
---

<section class="hero wrap" aria-labelledby="hero-name">
  <h1 id="hero-name" class="name rise">
    <span>{first}</span>
    <span class="surname">{rest.join(" ")}</span>
  </h1>

  <p class="meta mono rise">
    <span>{profile.role}</span>
    <span class="sep" aria-hidden="true"></span>
    <span>{profile.location}</span>
  </p>

  <div class="pitch rise step-2">
    <p class="headline">
      <span>{profile.headline.lead}</span>
      <span class="accent">{profile.headline.accent}</span>
    </p>
    <p class="dr-line">{profile.drLine}</p>
  </div>

  <ul class="stats mono rise step-3">
    {
      profile.stats.map((s) => (
        <li>
          <span class="value">{s.value}</span> {s.label}
        </li>
      ))
    }
  </ul>

  <div class="actions rise step-3" data-wall-clear>
    <a class="btn btn-primary" href={`mailto:${profile.email}`}>
      email<Icon name="mail" />
    </a>
    <a class="btn" href={profile.links.resume} download>
      resume.pdf<Icon name="download" />
    </a>
    <span class="socials">
      <a class="link" href={profile.links.github} target="_blank" rel="noopener noreferrer">
        github<Icon name="arrow-up-right" /><span class="sr-only">(opens in new tab)</span>
      </a>
      <a class="link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
        linkedin<Icon name="arrow-up-right" /><span class="sr-only">(opens in new tab)</span>
      </a>
    </span>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: calc(var(--nav-h) + clamp(1.25rem, 3vh, 3.5rem));
    padding-bottom: clamp(2.5rem, 7vh, 4rem);
  }

  /* ---------- name ---------- */

  .name {
    /* phones: "DELOS REYES" (~5.3em at this stretch) spans the gutters; wider screens: the shared hero size */
    font-size: max(var(--text-hero), min((100vw - 2 * var(--gutter)) / 5.32, 4.5rem));
    font-weight: 700;
    font-stretch: 88%;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--text);
    /* optical: pull the J and D stems onto the copy's left edge */
    margin-left: -0.04em;
  }

  .name span {
    display: block;
  }

  .surname {
    white-space: nowrap;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-top: clamp(1.1rem, 2.5vh, 1.6rem);
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  .sep {
    width: 1px;
    height: 0.9em;
    background: var(--line-strong);
  }

  /* narrow phones: role over location, so the separator never dangles at a line end */
  @media (max-width: 419px) {
    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .sep {
      display: none;
    }
  }

  /* ---------- the promise: a third of the name's size, normal width against its condensed bold ---------- */

  .pitch {
    margin-top: 1.25rem;
    max-width: 34rem;
  }

  .headline {
    font-size: clamp(1.35rem, 1rem + 1.1vw, 2rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }

  .headline span {
    display: block;
  }

  .accent {
    color: var(--accent);
  }

  .dr-line {
    margin-top: 1rem;
    max-width: 30em;
    color: var(--text-soft);
    text-wrap: balance;
  }

  /* ---------- proof list + the ways in ---------- */

  /* a three-line table: the one-line row needs ~600px, more than the copy column has beside the map */
  .stats {
    display: grid;
    gap: 0.3rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    color: var(--text-faint);
  }

  .value {
    display: inline-block;
    min-width: 3em;
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .socials {
    display: flex;
    gap: 1.5rem;
    width: 100%;
  }

  .socials .link {
    min-height: 2.75rem;
  }

  /* desktop: the copy centres in the viewport and holds the left ~52%, where the map masks its trace off */
  @media (min-width: 768px) {
    .hero {
      --copy-max: calc(52vw - max(0px, (100vw - 74rem) / 2) - var(--gutter));

      justify-content: center;
      padding-top: calc(var(--nav-h) + 3rem);
    }

    /* phones stay compact so the map's band fits under the copy; desktop breathes */
    .pitch,
    .stats {
      margin-top: clamp(2rem, 5vh, 3rem);
    }

    .stats {
      gap: 0.4rem;
    }

    .actions {
      margin-top: 1.75rem;
    }

    .meta,
    .pitch,
    .stats,
    .actions {
      max-width: min(34rem, var(--copy-max));
    }
  }

  /* the socials join the buttons' row once the column is wide enough to hold all four */
  @media (min-width: 1024px) {
    .socials {
      width: auto;
      margin-left: 0.75rem;
    }
  }

  /* one quiet on-load rise, three steps; the map is the motion.
     GroundTrack's HERO_SETTLE_MS assumes 560ms + 2 x 90ms */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 560ms var(--ease-out-expo) both;
    }

    .step-2 {
      animation-delay: 90ms;
    }

    .step-3 {
      animation-delay: 180ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }
</style>
