---
// Case studies index: the page's proof, one editorial row per study, right under the hero.
// Each row borrows company, period and map station from the role whose refs link to it.
// Hovering, focusing, or scrolling a row across mid-screen lights that station on the map.
import { caseStudies } from "../data/case-studies";
import { experience } from "../data/profile";
import Icon from "./ui/Icon.astro";

const NOW = "Present";
const STACK_SHOWN = 3;

const rows = caseStudies.map((study) => {
  const href = `/case-studies/${study.slug}/`;
  const role = experience.find((r) => r.refs.some((ref) => ref.href === href));
  if (!role) throw new Error(`Work: no role in profile.ts links to ${href}`);
  return { study, href, role };
});
---

<section id="work" class="section" aria-labelledby="work-heading">
  <div class="wrap">
    <div class="col">
      <h2 id="work-heading" class="h-section">Case studies</h2>
      <ol class="index reveal" role="list" data-work-index>
        {
          rows.map(({ study, href, role }) => {
            const current = role.period.includes(NOW);
            const [since] = role.period.split(NOW);
            return (
              <li>
                <a class="row" href={href} data-station={role.station}>
                  <h3 class="title">
                    {study.title.lead} {study.title.accent}
                  </h3>
                  <p class="tagline">{study.tagline}</p>
                  <p class="meta mono">
                    <span class="station">{role.station}</span>{" "}
                    <span class="co">{role.company}</span>{" "}
                    <span class="when">
                      {current && <span class="dot" aria-hidden="true" />}
                      {current ? (
                        <span>
                          {since}
                          <span class="now">{NOW}</span>
                        </span>
                      ) : (
                        role.period
                      )}
                    </span>
                  </p>
                  <span class="stack">
                    {study.stack.slice(0, STACK_SHOWN).map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </span>
                  <Icon name="arrow-right" class="go" />
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* desktop: the index holds the left ~56% of the viewport so the lit station shows beside it */
  @media (min-width: 768px) {
    .col {
      max-width: calc(56vw - max((100vw - 74rem) / 2, 0px) - var(--gutter));
    }
  }

  .h-section {
    margin-bottom: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
  }

  .index {
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .index > li {
    border-top: 1px solid var(--line);
  }

  /* title first in the DOM so the link's name leads with it; the meta line sits above it visually */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    /* room for the arrow's nudge inside the focus ring */
    padding-right: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .row > :not(.go) {
    grid-column: 1;
  }

  .meta {
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.25rem;
    color: var(--text-faint);
  }

  .station {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .station::before {
    content: "";
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
  }

  .co {
    color: var(--text-soft);
  }

  .when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .now {
    color: var(--accent);
  }

  .title {
    grid-row: 2;
    margin-top: 0.7rem;
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.75rem);
    font-weight: 680;
    font-stretch: 88%;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--text);
    transition: color var(--duration) ease;
  }

  .tagline {
    grid-row: 3;
    max-width: 48ch;
    margin-top: 0.65rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .stack {
    grid-row: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .row :global(.go) {
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.7rem;
    color: var(--text-faint);
    transition:
      color var(--duration) ease,
      transform 320ms var(--ease-out-expo);
  }

  /* ---------- states: the arrow goes lime and steps forward; the other titles step back ---------- */

  .row:focus-visible {
    outline-offset: 0.5rem;
  }

  .row:hover :global(.go),
  .row:focus-visible :global(.go) {
    color: var(--accent);
    transform: translateX(0.4rem);
  }

  .row:active :global(.go) {
    transform: translateX(0.65rem);
  }

  .index:has(.row:focus-visible) .row:not(:focus-visible) .title {
    color: var(--text-soft);
  }

  @media (hover: hover) {
    .index:has(.row:hover) .row:not(:hover) .title {
      color: var(--text-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row :global(.go) {
      transition: color var(--duration) ease;
    }

    .row:hover :global(.go),
    .row:focus-visible :global(.go),
    .row:active :global(.go) {
      transform: none;
    }
  }

  @media (max-width: 559px) {
    .stack {
      display: none;
    }

    .row :global(.go) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
</style>

<script>
  // Map link: a held row (hovered or focused) wins; otherwise the row crossing mid-screen.
  // Nothing held and nothing centred (incl. the section out of view) clears the station.
  const list = document.querySelector<HTMLElement>("[data-work-index]");

  if (list) {
    const rows = [...list.querySelectorAll<HTMLElement>("[data-station]")];
    const inBand = new Set<Element>();
    let held: string | null = null;
    let centred: string | null = null;
    let lit: string | null = null;

    const sync = () => {
      const code = held ?? centred;
      if (code === lit) return;
      lit = code;
      window.dispatchEvent(new CustomEvent("station:focus", { detail: code }));
    };

    const hold = (code: string | null) => {
      held = code;
      sync();
    };

    for (const row of rows) {
      row.addEventListener("mouseenter", () => hold(row.dataset.station ?? null));
      row.addEventListener("focus", () => hold(row.dataset.station ?? null));
    }
    list.addEventListener("mouseleave", () => hold(null));
    list.addEventListener("focusout", (e) => {
      if (!list.contains(e.relatedTarget as Node | null)) hold(null);
    });

    const band = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) inBand.add(e.target);
          else inBand.delete(e.target);
        }
        centred = rows.find((r) => inBand.has(r))?.dataset.station ?? null;
        sync();
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    rows.forEach((r) => band.observe(r));
  }
</script>
